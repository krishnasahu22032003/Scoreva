generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{

id        Int      @id @default(autoincrement()) 
username  String
email     String   @unique
password  String   
createdAt DateTime @default(now())

}

model Matches {

id              Int         @id                  @default(autoincrement())
sport           String    
firstTeam       String
secondTeam      String
status          MatchStatus @default(UPCOMING)
startTime       DateTime
endTime         DateTime
firstTeamScore  Int         @default(0)
secondTeamScore Int         @default(0)
createdAt        DateTime    @default(now())

}


enum MatchStatus{

UPCOMING
ENDED
LIVE

}