generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{

id        Int      @id @default(autoincrement()) 
username  String
email     String   @unique
password  String   
createdAt DateTime @default(now())

}

model Match {

id              Int         @id                  @default(autoincrement())
sport           String    
firstTeam       String
secondTeam      String
status          MatchStatus @default(UPCOMING)
startTime       DateTime
endTime         DateTime
firstTeamScore  Int         @default(0)
secondTeamScore Int         @default(0)
createdAt        DateTime    @default(now())
commentaries     Commentary[]
}

model Commentary{

id            Int          @id    @default(autoincrement())
matchId       Int
match         Match        @relation(fields: [matchId], references: [id] ,onDelete: Cascade)
minute        Int?
sequence      Int?
period        String?
eventType     String?
actor         String?
team          String?
message       String
metadata      Json?
tags          String[]
createdAt     DateTime   @default(now())

  @@index([matchId])
  @@index([matchId, sequence])

}

enum MatchStatus{

UPCOMING
ENDED
LIVE

}